[vault-baseos-10.2]
name=AlmaLinux 10.2 - BaseOS
baseurl=https://vault.almalinux.org/10.2/BaseOS/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-AlmaLinux-10

[vault-appstream-10.2]
name=AlmaLinux 10.2 - AppStream
baseurl=https://vault.almalinux.org/10.2/AppStream/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-AlmaLinux-10
