From bc83a3ca9e4c537fb53cfab992e5156ee4a5bc8c Mon Sep 17 00:00:00 2001
From: Kentaro Hayashi <hayashi@clear-code.com>
Date: Wed, 2 Sep 2026 16:35:05 +0900
Subject: [PATCH] Bump version to v7

Signed-off-by: Kentaro Hayashi <hayashi@clear-code.com>
---
 fluent-package/config.rb                  | 10 +++++-----
 fluent-package/debian/changelog           |  6 ++++++
 fluent-package/yum/fluent-package.spec.in |  3 +++
 3 files changed, 14 insertions(+), 5 deletions(-)

diff --git a/fluent-package/config.rb b/fluent-package/config.rb
index ed61b64..7207f8b 100644
--- a/fluent-package/config.rb
+++ b/fluent-package/config.rb
@@ -1,5 +1,5 @@
 PACKAGE_NAME = "fluent-package"
-PACKAGE_VERSION = "6.1.0"
+PACKAGE_VERSION = "7.0.0"
 
 # Keep internal path (/opt/td-agent) for package name migration
 SERVICE_NAME = "fluentd"
@@ -26,8 +26,8 @@ OPENSSL_FOR_LTS_VERSION = "3.5.8"
 OPENSSL_FOR_LTS_SHA256SUM = "a8f84a39918ec6415ce765d9b429d313ba97b8143169c172e734b9514464f5b2"
 
 # https://www.ruby-lang.org/en/downloads/ (tar.gz)
-BUNDLED_RUBY_VERSION = "3.4.10"
-BUNDLED_RUBY_SOURCE_SHA256SUM = "ecee2d072a14f2d14347dd56dfd8fe5c3130abf5117bfaacbda0f4ef9cc429ec"
+BUNDLED_RUBY_VERSION = "4.0.6"
+BUNDLED_RUBY_SOURCE_SHA256SUM = "837d299e8f7ddf2be31a229a7a7e019d354979825117989acb3b32b1a9be262a"
 
 BUNDLED_RUBY_PATCHES = [
   # An example entry:
@@ -35,8 +35,8 @@ BUNDLED_RUBY_PATCHES = [
 ]
 
 # https://rubyinstaller.org/downloads/ (7-ZIP ARCHIVES)
-BUNDLED_RUBY_INSTALLER_X64_VERSION = "3.4.10-1"
-BUNDLED_RUBY_INSTALLER_X64_SHA256SUM = "89e3c5e235ac88b9b7e8daaf639eaaab74d7c470667354f6bf0f7432f3191ebb"
+BUNDLED_RUBY_INSTALLER_X64_VERSION = "4.0.6-1"
+BUNDLED_RUBY_INSTALLER_X64_SHA256SUM = "328d7a86bea2f4c432783025050c9ffa1c36fcfc54ebccc466b63450ec3af223"
 
 # Files under rubyinstaller/ are patches for RubyInstaller's binary package.
 # Other patches for Ruby's source tree which can be shared with BUNDLED_RUBY_PATCHES.
diff --git a/fluent-package/debian/changelog b/fluent-package/debian/changelog
index 8b17497..de4615c 100644
--- a/fluent-package/debian/changelog
+++ b/fluent-package/debian/changelog
@@ -1,3 +1,9 @@
+fluent-package (7.0.0-1) unstable; urgency=low
+
+  * New upstream release.
+
+ -- Shizuo Fujita <fujita@clear-code.com>  Sun, 29 Aug 2027 13:55:06 -0000
+
 fluent-package (6.1.0-1) unstable; urgency=low
 
   * New upstream release.
diff --git a/fluent-package/yum/fluent-package.spec.in b/fluent-package/yum/fluent-package.spec.in
index ad9eb89..e6ede97 100644
--- a/fluent-package/yum/fluent-package.spec.in
+++ b/fluent-package/yum/fluent-package.spec.in
@@ -482,6 +482,9 @@ fi
 # NOTE: %{_tmpfilesdir} is available since CentOS 7
 %attr(0755,fluentd,fluentd) %dir /tmp/@PACKAGE_DIR@
 %changelog
+* Sun Aug 29 2027 Shizuo Fujita <fujita@clear-code.com> - 7.0.0-1
+- New upstream release.
+
 * Wed Aug 05 2026 Shizuo Fujita <fujita@clear-code.com> - 6.1.0-1
 - New upstream release.
 
