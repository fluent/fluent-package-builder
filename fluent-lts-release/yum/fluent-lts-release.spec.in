# -*- rpm -*-

%define _amzn %{?amzn}%{!?amzn:0}
%define is_amazon_linux (%{_amzn} != 0)

Name:		@PACKAGE@
Version:	@VERSION@
Release:	@RELEASE@%{?dist}
Summary:	Fluent Package release files
BuildArchitectures: noarch

License:	ASL 2.0
URL:		https://docs.fluentd.org/
Source0:	@PACKAGE@-@VERSION@.tar.gz

%description
The stable distribution of Fluentd release repository files

%prep
%setup -q -n @PACKAGE@-%{version}

%build

%install

mkdir -p %{buildroot}%{_sysconfdir}/pki/rpm-gpg/
%{__install} -Dp -t %{buildroot}%{_sysconfdir}/pki/rpm-gpg/ -m0644 RPM-GPG-KEY-*

mkdir -p %{buildroot}%{_sysconfdir}/yum.repos.d/

if grep -qs 'Amazon Linux' /etc/os-release; then
  if grep -qs 'VERSION="2"' /etc/os-release; then
    echo "Install .repo for Amazon Linux 2"
    cp fluent-package-amazonlinux2.repo fluent-package-lts.repo
  else
    echo "Install .repo for Amazon Linux 2023"
    cp fluent-package-amazonlinux2023.repo fluent-package-lts.repo
  fi
else
    echo "Install .repo for RHEL compatible distribution"
    cp fluent-package-rhel-compat.repo fluent-package-lts.repo
fi
%{__install} -D --preserve-timestamps --target-directory %{buildroot}%{_sysconfdir}/yum.repos.d/ --mode=0644 fluent-package-lts.repo

%files
%defattr(-,root,root,-)
%dir %{_sysconfdir}/yum.repos.d/
%config(noreplace) %{_sysconfdir}/yum.repos.d/*.repo
%dir %{_sysconfdir}/pki/rpm-gpg/
%config(noreplace) %{_sysconfdir}/pki/rpm-gpg/RPM-GPG-KEY-td-agent
%config(noreplace) %{_sysconfdir}/pki/rpm-gpg/RPM-GPG-KEY-fluent-package

%changelog
* Thu Oct 29 2026 Kentaro Hayashi <hayashi@clear-code.com> - 2026.10.29-1
- New upstream release.
- Use packages.fluentd.org as gateway.

  The default URI of package repository was changed
  from fluentd.cdn.cncf.io to packages.fluentd.org.

  Why: we want to know how Fluent Package is used, such as which
  distributions, versions and architectures are popular. This helps us
  decide which platforms to support and when to end support for old ones.
  The new URI goes through scarf.sh (https://scarf.sh) to collect download
  statistics, and then redirects your request to the same CDN as before
  (https://fluentd.cdn.cncf.io).

  What is collected: the Fluentd developers can see the type of client
  (apt, dnf and so on) and the country of the request. We cannot see your
  IP address. See the scarf.sh privacy policy for details:
  https://about.scarf.sh/privacy-policy/

  Packages and their GPG signatures are not changed. They are still served
  from https://fluentd.cdn.cncf.io.

  If your network limits outgoing access, you may need to allow
  packages.fluentd.org, fluentd.gateway.scarf.sh in addition to
  fluentd.cdn.cncf.io.

  If you do not want to be counted, change the URI in
  /etc/yum.repos.d/fluent-package-lts.repo back to
  https://fluentd.cdn.cncf.io. We have no plan to stop serving packages
  from that URI.

* Wed Sep 24 2025 Shizuo Fujita <fujita@clear-code.com> - 2025.9.29-1
- New upstream release.

* Fri Aug 29 2025 Kentaro Hayashi <hayashi@clear-code.com> - 2025.8.29-1
- New upstream release.
